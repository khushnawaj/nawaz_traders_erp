# -------------------------------------------------------------
# 🌾 Nawaz Traders ERP — Production Environment Template
# DO NOT COMMIT ACTUAL PRODUCTION PASSWORDS TO GIT!
# -------------------------------------------------------------

# Production Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PROD_PASSWORD@postgres:5432/nawaz_traders_prod?schema=public"

# Database Configuration (Used by docker-compose.prod.yml)
DB_USER="postgres"
DB_PASSWORD="YOUR_STRONG_PROD_PASSWORD"
DB_NAME="nawaz_traders_prod"
DB_PORT=5432

# Production JWT Secret (Generate using: openssl rand -hex 32)
JWT_SECRET="YOUR_RANDOM_LONG_SECURE_JWT_SECRET_STRING_2026"

# Environment
NODE_ENV="production"
PORT=3000
